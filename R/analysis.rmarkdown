## Overlapping concepts between items


```{r}

# =========================================================
# 1) One row per study_id
# =========================================================

study_lookup <- study %>%
  transmute(
    study_id,
    year = as.integer(year),
    discipline = str_squish(as.character(discipline)),
    methodology = str_squish(as.character(methodology_category)),
    guideline_type = str_squish(as.character(guideline_extension))
  ) %>%
  mutate(
    guideline_type = tolower(guideline_type),
    guideline_type = case_when(
      guideline_type %in% c("original", "origional") ~ "Original",
      guideline_type == "update" ~ "Update",
      guideline_type == "extension" ~ "Extension",
      TRUE ~ str_to_title(guideline_type)
    ),
    discipline = na_if(discipline, ""),
    methodology = na_if(methodology, ""),
    guideline_type = na_if(guideline_type, "")
  ) %>%
  distinct(study_id, .keep_all = TRUE)

# =========================================================
# 2) Concept-level base data
# =========================================================

concept_sets_base <- concept %>%
  filter(
    !is.na(study_id),
    !is.na(standardised_reporting_item_elements)
  ) %>%
  left_join(study_lookup, by = "study_id") %>%
  mutate(
    standardised_reporting_item_elements =
      str_squish(as.character(standardised_reporting_item_elements)),
    guideline = as.character(study_id)
  ) %>%
  filter(standardised_reporting_item_elements != "") %>%
  distinct(
    guideline,
    study_id,
    discipline,
    methodology,
    guideline_type,
    standardised_reporting_item_elements
  )

# =========================================================
# 3) Helper: build set list for a grouping variable
# =========================================================

make_set_list <- function(data, group_var) {
  group_var <- rlang::ensym(group_var)

  data %>%
    filter(!is.na(!!group_var)) %>%
    group_by(!!group_var) %>%
    summarise(
      concepts = list(sort(unique(standardised_reporting_item_elements))),
      n_concepts = n_distinct(standardised_reporting_item_elements),
      .groups = "drop"
    ) %>%
    rename(group = !!group_var)
}

# =========================================================
# 4) Helper: pairwise Jaccard overlap
# =========================================================

calc_pairwise_overlap <- function(set_list) {
  if (nrow(set_list) < 2) {
    return(
      tibble(
        group_1 = character(),
        group_2 = character(),
        n_1 = integer(),
        n_2 = integer(),
        shared_n = integer(),
        unique_1_n = integer(),
        unique_2_n = integer(),
        jaccard = numeric()
      )
    )
  }

  combn(seq_len(nrow(set_list)), 2, simplify = FALSE) %>%
    map_dfr(function(idx) {
      a <- set_list$concepts[[idx[1]]]
      b <- set_list$concepts[[idx[2]]]

      inter <- intersect(a, b)
      union_ab <- union(a, b)

      tibble(
        group_1 = as.character(set_list$group[idx[1]]),
        group_2 = as.character(set_list$group[idx[2]]),
        n_1 = length(a),
        n_2 = length(b),
        shared_n = length(inter),
        unique_1_n = length(setdiff(a, b)),
        unique_2_n = length(setdiff(b, a)),
        jaccard = ifelse(length(union_ab) == 0, NA_real_, length(inter) / length(union_ab))
      )
    })
}

# =========================================================
# 5) Helper: summary stats
# =========================================================

calc_overlap_stats <- function(pairwise_overlap) {
  if (nrow(pairwise_overlap) == 0) {
    return(
      tibble(
        n = 0L,
        mean_jaccard = NA_real_,
        sd_jaccard = NA_real_,
        median_jaccard = NA_real_,
        q1_jaccard = NA_real_,
        q3_jaccard = NA_real_
      )
    )
  }

  pairwise_overlap %>%
    summarise(
      n = n(),
      mean_jaccard = mean(jaccard, na.rm = TRUE),
      sd_jaccard = sd(jaccard, na.rm = TRUE),
      median_jaccard = median(jaccard, na.rm = TRUE),
      q1_jaccard = quantile(jaccard, probs = 0.25, na.rm = TRUE),
      q3_jaccard = quantile(jaccard, probs = 0.75, na.rm = TRUE)
    )
}

# =========================================================
# 6) Helper: formatted summary string
# =========================================================

format_overlap_stats <- function(overlap_stats) {
  overlap_stats %>%
    mutate(
      mean_sd_n = sprintf("%.3f (SD %.3f), n = %d",
                          mean_jaccard, sd_jaccard, n)
    )
}

# =========================================================
# 7) Plot theme helpers
# =========================================================

plot_overlap_dist <- function(pairwise_overlap, title_text, fill_col) {
  ggplot(pairwise_overlap, aes(x = jaccard)) +
    geom_histogram(
      bins = 18,
      fill = fill_col,
      color = "white",
      linewidth = 0.4,
      alpha = 0.95
    ) +
    scale_x_continuous(
      labels = label_number(accuracy = 0.01),
      limits = c(0, 1),
      expand = expansion(mult = c(0.01, 0.02))
    ) +
    labs(
      title = title_text,
      x = "Pairwise Jaccard overlap",
      y = "Count"
    ) +
    theme_classic(base_size = 16) +
    theme(
      plot.title = element_text(
        face = "bold",
        hjust = 0,
        size = 18,
        margin = margin(b = 12)
      ),
      axis.title = element_text(size = 16, color = "black"),
      axis.text = element_text(size = 13, color = "black"),
      axis.line = element_line(color = "black", linewidth = 0.7),
      axis.ticks = element_line(color = "black", linewidth = 0.6),
      panel.border = element_blank(),
      plot.margin = margin(t = 12, r = 12, b = 12, l = 12),
      legend.position = "none"
    )
}

make_heatmap_data <- function(set_list, pairwise_overlap) {
  bind_rows(
    pairwise_overlap,
    pairwise_overlap %>%
      transmute(
        group_1 = group_2,
        group_2 = group_1,
        n_1 = n_2,
        n_2 = n_1,
        shared_n = shared_n,
        unique_1_n = unique_2_n,
        unique_2_n = unique_1_n,
        jaccard = jaccard
      ),
    tibble(
      group_1 = as.character(set_list$group),
      group_2 = as.character(set_list$group),
      n_1 = set_list$n_concepts,
      n_2 = set_list$n_concepts,
      shared_n = set_list$n_concepts,
      unique_1_n = 0,
      unique_2_n = 0,
      jaccard = 1
    )
  )
}

plot_overlap_heatmap <- function(set_list, pairwise_overlap, title_text, high_col) {
  heatmap_data <- make_heatmap_data(set_list, pairwise_overlap)

  group_order <- set_list %>%
    arrange(desc(n_concepts)) %>%
    pull(group) %>%
    as.character()

  heatmap_data <- heatmap_data %>%
    mutate(
      group_1 = factor(as.character(group_1), levels = group_order),
      group_2 = factor(as.character(group_2), levels = rev(group_order))
    )

  ggplot(heatmap_data, aes(x = group_1, y = group_2, fill = jaccard)) +
    geom_tile(color = "white", linewidth = 0.35) +
    scale_fill_gradient(
      low = "#f7f7f7",
      high = high_col,
      limits = c(0, 1),
      labels = label_number(accuracy = 0.01)
    ) +
    coord_fixed() +
    labs(
      title = title_text,
      x = NULL,
      y = NULL,
      fill = "Jaccard overlap"
    ) +
    theme_classic(base_size = 16) +
    theme(
      plot.title = element_text(
        face = "bold",
        hjust = 0,
        size = 18,
        margin = margin(b = 14)
      ),
      axis.text.x = element_text(
        angle = 55,
        hjust = 1,
        vjust = 1,
        size = 10.5,
        color = "black"
      ),
      axis.text.y = element_text(
        size = 10.5,
        color = "black"
      ),
      axis.line = element_line(color = "black", linewidth = 0.7),
      axis.ticks = element_blank(),
      legend.position = "none",
      panel.border = element_blank(),
      plot.margin = margin(t = 15, r = 18, b = 40, l = 40)
    )
}

# =========================================================
# 7b) Top-20 focused heatmap helpers
# =========================================================

compute_guideline_mean_overlap <- function(pairwise_df) {
  if (nrow(pairwise_df) == 0) {
    return(tibble(group = character(), mean_jaccard = numeric()))
  }

  bind_rows(
    pairwise_df %>%
      transmute(group = group_1, other = group_2, jaccard = jaccard),
    pairwise_df %>%
      transmute(group = group_2, other = group_1, jaccard = jaccard)
  ) %>%
    group_by(group) %>%
    summarise(
      mean_jaccard = mean(jaccard, na.rm = TRUE),
      .groups = "drop"
    ) %>%
    arrange(desc(mean_jaccard))
}

plot_topN_guidelines_heatmap <- function(set_list, pairwise_overlap, title_text, high_col, top_n = 20) {
  if (nrow(set_list) == 0 || nrow(pairwise_overlap) == 0) {
    return(NULL)
  }

  mean_overlap <- compute_guideline_mean_overlap(pairwise_overlap)

  top_groups <- mean_overlap %>%
    slice_head(n = top_n) %>%
    pull(group) %>%
    as.character()

  top_groups <- top_groups[top_groups %in% set_list$group]

  if (length(top_groups) < 2) {
    return(NULL)
  }

  heatmap_data <- make_heatmap_data(set_list, pairwise_overlap) %>%
    filter(
      as.character(group_1) %in% top_groups,
      as.character(group_2) %in% top_groups
    ) %>%
    mutate(
      group_1 = factor(as.character(group_1), levels = top_groups),
      group_2 = factor(as.character(group_2), levels = rev(top_groups))
    )

  ggplot(heatmap_data, aes(x = group_1, y = group_2, fill = jaccard)) +
    geom_tile(color = "white", linewidth = 0.35) +
    scale_fill_gradient(
      low = "#f7f7f7",
      high = high_col,
      limits = c(0, 1),
      labels = label_number(accuracy = 0.01)
    ) +
    coord_fixed() +
    labs(
      title = title_text,
      x = NULL,
      y = NULL
    ) +
    theme_classic(base_size = 13) +
    theme(
      plot.title = element_text(
        face = "bold",
        hjust = 0,
        size = 16,
        margin = margin(b = 12)
      ),
      axis.text.x = element_text(
        angle = 45,
        hjust = 1,
        vjust = 1,
        size = 8.5,
        color = "black"
      ),
      axis.text.y = element_text(
        size = 8.5,
        color = "black"
      ),
      axis.line = element_line(color = "black", linewidth = 0.7),
      axis.ticks = element_blank(),
      legend.position = "none",
      panel.border = element_blank(),
      plot.margin = margin(t = 15, r = 15, b = 35, l = 15)
    )
}

# =========================================================
# 8) Save helper
# =========================================================

save_plot_both <- function(plot_obj, filename_stub, width, height) {
  ggsave(
    filename = here::here("figures", paste0(filename_stub, ".png")),
    plot = plot_obj,
    width = width,
    height = height,
    units = "in",
    dpi = 500,
    bg = "white"
  )

  ggsave(
    filename = here::here("figures", paste0(filename_stub, ".pdf")),
    plot = plot_obj,
    width = width,
    height = height,
    units = "in",
    bg = "white"
  )
}

# =========================================================
# 9) Colours
# =========================================================

guideline_col  <- "#5c8f7a"
discipline_col <- "#6c63a8"
method_col     <- "#4f88a2"
type_col       <- "#74bda3"

# =========================================================
# 10) OVERALL guideline-to-guideline overlap
# =========================================================

guideline_set_list <- make_set_list(concept_sets_base, guideline)
guideline_pairwise_overlap <- calc_pairwise_overlap(guideline_set_list)
guideline_overlap_stats <- calc_overlap_stats(guideline_pairwise_overlap)
guideline_overlap_stats_fmt <- format_overlap_stats(guideline_overlap_stats)

guideline_overlap_dist <- plot_overlap_dist(
  guideline_pairwise_overlap,
  title_text = "Pairwise concept overlap across all guidelines",
  fill_col = guideline_col
)

guideline_overlap_heatmap <- plot_overlap_heatmap(
  guideline_set_list,
  guideline_pairwise_overlap,
  title_text = "Concept overlap heatmap across all guidelines",
  high_col = guideline_col
)

guideline_top20_overlap_heatmap <- plot_topN_guidelines_heatmap(
  guideline_set_list,
  guideline_pairwise_overlap,
  title_text = "Top 20 guidelines by mean pairwise concept overlap",
  high_col = guideline_col,
  top_n = 20
)

save_plot_both(guideline_overlap_dist, "guideline_overlap_distribution", 8.3, 5.8)
save_plot_both(guideline_overlap_heatmap, "guideline_overlap_heatmap", 11.7, 11.2)

if (!is.null(guideline_top20_overlap_heatmap)) {
  save_plot_both(
    guideline_top20_overlap_heatmap,
    "guideline_top20_overlap_heatmap",
    9.5,
    9.0
  )
}

# =========================================================
# 11) DISCIPLINE overlap
# =========================================================

discipline_set_list <- make_set_list(concept_sets_base, discipline)
discipline_pairwise_overlap <- calc_pairwise_overlap(discipline_set_list)
discipline_overlap_stats <- calc_overlap_stats(discipline_pairwise_overlap)
discipline_overlap_stats_fmt <- format_overlap_stats(discipline_overlap_stats)

discipline_overlap_dist <- plot_overlap_dist(
  discipline_pairwise_overlap,
  title_text = "Pairwise concept overlap across disciplines",
  fill_col = discipline_col
)

discipline_overlap_heatmap <- plot_overlap_heatmap(
  discipline_set_list,
  discipline_pairwise_overlap,
  title_text = "Concept overlap heatmap by discipline",
  high_col = discipline_col
)

save_plot_both(discipline_overlap_dist, "discipline_overlap_distribution", 8.3, 5.8)
save_plot_both(discipline_overlap_heatmap, "discipline_overlap_heatmap", 10.5, 9.5)

# =========================================================
# 12) METHODOLOGY overlap
# =========================================================

method_set_list <- make_set_list(concept_sets_base, methodology)
method_pairwise_overlap <- calc_pairwise_overlap(method_set_list)
method_overlap_stats <- calc_overlap_stats(method_pairwise_overlap)
method_overlap_stats_fmt <- format_overlap_stats(method_overlap_stats)

method_overlap_dist <- plot_overlap_dist(
  method_pairwise_overlap,
  title_text = "Pairwise concept overlap across methodologies",
  fill_col = method_col
)

method_overlap_heatmap <- plot_overlap_heatmap(
  method_set_list,
  method_pairwise_overlap,
  title_text = "Concept overlap heatmap by methodology",
  high_col = method_col
)

save_plot_both(method_overlap_dist, "methodology_overlap_distribution", 8.3, 5.8)
save_plot_both(method_overlap_heatmap, "methodology_overlap_heatmap", 10.8, 9.8)

# =========================================================
# 13) GUIDELINE TYPE overlap
# =========================================================

type_set_list <- make_set_list(concept_sets_base, guideline_type)
type_pairwise_overlap <- calc_pairwise_overlap(type_set_list)
type_overlap_stats <- calc_overlap_stats(type_pairwise_overlap)
type_overlap_stats_fmt <- format_overlap_stats(type_overlap_stats)

type_overlap_dist <- plot_overlap_dist(
  type_pairwise_overlap,
  title_text = "Pairwise concept overlap across guideline types",
  fill_col = type_col
)

type_overlap_heatmap <- plot_overlap_heatmap(
  type_set_list,
  type_pairwise_overlap,
  title_text = "Concept overlap heatmap by guideline type",
  high_col = type_col
)

save_plot_both(type_overlap_dist, "guideline_type_overlap_distribution", 8.3, 5.8)
save_plot_both(type_overlap_heatmap, "guideline_type_overlap_heatmap", 8.5, 7.5)

# =========================================================
# 14) Combine summary tables
# =========================================================

all_overlap_stats <- bind_rows(
  guideline_overlap_stats %>% mutate(grouping = "Guideline"),
  discipline_overlap_stats %>% mutate(grouping = "Discipline"),
  method_overlap_stats %>% mutate(grouping = "Methodology"),
  type_overlap_stats %>% mutate(grouping = "Guideline type")
) %>%
  select(grouping, everything())

all_overlap_stats_fmt <- bind_rows(
  guideline_overlap_stats_fmt %>% mutate(grouping = "Guideline"),
  discipline_overlap_stats_fmt %>% mutate(grouping = "Discipline"),
  method_overlap_stats_fmt %>% mutate(grouping = "Methodology"),
  type_overlap_stats_fmt %>% mutate(grouping = "Guideline type")
) %>%
  select(grouping, everything())

readr::write_csv(all_overlap_stats, here::here("figures", "all_overlap_stats.csv"))
readr::write_csv(all_overlap_stats_fmt, here::here("figures", "all_overlap_stats_formatted.csv"))

# =========================================================
# 15) Optional: print objects to console
# =========================================================

guideline_overlap_stats
discipline_overlap_stats
method_overlap_stats
type_overlap_stats
all_overlap_stats
all_overlap_stats_fmt
```

