  # height   = 11.0,
  # units    = "cm",
  # dpi      = 300,
  # bg       = "white"
#)
```

```{r}
# settings
lollipop_years <- c(2000, 2005, 2010, 2015, 2020, 2025)

pal <- c(
  "Medicine" = "#f29e4c",
  "Psychology" = "#efea5a",
  "Environmental science" = "#83e377",
  "Other" = "#0db39e"
)

# clean discipline labels first
discipline_base <- study %>%
  filter(!is.na(year), !is.na(discipline)) %>%
  distinct(year, study_id, discipline) %>%
  mutate(
    discipline = str_squish(str_to_lower(discipline)),
    discipline = case_when(
      discipline == "medicine" ~ "Medicine",
      discipline == "psychology" ~ "Psychology",
      discipline == "environmental science" ~ "Environmental science",
      TRUE ~ "Other"
    )
  )

# order disciplines by oldest first appearance
discipline_levels <- discipline_base %>%
  group_by(discipline) %>%
  summarise(first_year = min(year), .groups = "drop") %>%
  arrange(first_year, discipline) %>%
  pull(discipline)

legend_order <- discipline_levels

# cumulative counts by discipline
discipline_year <- discipline_base %>%
  mutate(
    discipline = factor(discipline, levels = discipline_levels)
  ) %>%
  count(year, discipline, name = "n") %>%
  complete(
    year = full_seq(year, 1),
    discipline,
    fill = list(n = 0)
  ) %>%
  arrange(discipline, year) %>%
  group_by(discipline) %>%
  mutate(cum_n = cumsum(n)) %>%
  ungroup()

# smooth each discipline separately
smooth_discipline_year <- discipline_year %>%
  group_by(discipline) %>%
  group_modify(~ {
    x_seq <- seq(min(.x$year), max(.x$year), length.out = 500)
    spline_fn <- splinefun(.x$year, .x$cum_n, method = "monoH.FC")

    tibble(
      year = x_seq,
      cum_n = spline_fn(x_seq)
    )
  }) %>%
  ungroup()

# overall cumulative totals for lollipops
guide_per_year <- study %>%
  filter(!is.na(year)) %>%
  distinct(year, study_id) %>%
  count(year, name = "n") %>%
  complete(
    year = full_seq(year, 1),
    fill = list(n = 0)
  ) %>%
  arrange(year) %>%
  mutate(cum_n = cumsum(n))

lollipop_data <- guide_per_year %>%
  filter(year %in% lollipop_years)

max_cum <- max(guide_per_year$cum_n, na.rm = TRUE)
offset <- max_cum * 0.018
label_offset <- max_cum * 0.03

count_cum_discipline <- ggplot() +
  geom_area(
    data = smooth_discipline_year,
    aes(x = year, y = cum_n, fill = discipline),
    position = "stack",
    color = NA,
    alpha = 0.95
  ) +
  geom_segment(
    data = lollipop_data,
    aes(x = year, xend = year, y = 0, yend = cum_n + offset),
    color = "black",
    linewidth = 1
  ) +
  geom_point(
    data = lollipop_data,
    aes(x = year, y = cum_n + offset),
    color = "black",
    size = 3
  ) +
  geom_text(
    data = lollipop_data,
    aes(x = year, y = cum_n + offset + label_offset, label = comma(cum_n)),
    vjust = 0,
    fontface = "bold",
    size = 3.3,
    color = "black",
    show.legend = FALSE
  ) +
  scale_fill_manual(
    values = pal,
    breaks = legend_order,
    name = NULL
  ) +
  guides(
    fill = guide_legend(
      ncol = 1,
      byrow = TRUE,
      override.aes = list(alpha = 1, colour = NA),
      keyheight = unit(0.55, "cm"),
      keywidth = unit(0.55, "cm")
    )
  ) +
  scale_x_continuous(
    breaks = lollipop_years,
    expand = expansion(mult = c(0, 0.02))
  ) +
  scale_y_continuous(
    breaks = seq(0, 60, by = 10),
    labels = comma,
    expand = c(0, 0)
  ) +
  coord_cartesian(
    ylim = c(0, 60),
    clip = "off"
  ) +
  labs(
    title = "b) Grouped by discipline"
  ) +
  theme_minimal(base_size = 13) +
  theme(
    panel.grid = element_blank(),
    axis.title = element_blank(),
    axis.text.y = element_text(color = "black"),
    axis.ticks.y = element_line(color = "black"),
    axis.line.x = element_line(linewidth = 0.8, color = "black"),
    axis.line.y = element_line(linewidth = 0.8, color = "black"),
    legend.position = "inside",
    legend.position.inside = c(0.03, 0.97),
