#### Tables of concepts per item


```{r}
section_order <- c(
  "Other information",
  "Discussion",
  "Results",
  "Methodology",
  "Introduction",
  "Abstract",
  "Title"
)

concept_tables_by_section <- concept %>%
  filter(
    !is.na(standardised_section),
    !is.na(standardised_reporting_item_elements)
  ) %>%
  mutate(
    standardised_section = str_squish(as.character(standardised_section)),
    standardised_section = case_when(
      str_to_lower(standardised_section) %in% c("other", "other information") ~ "Other information",
      TRUE ~ standardised_section
    ),
    standardised_section = factor(
      standardised_section,
      levels = section_order
    ),
    standardised_reporting_item_elements =
      str_squish(as.character(standardised_reporting_item_elements))
  ) %>%
  filter(
    !is.na(standardised_section),
    standardised_reporting_item_elements != ""
  ) %>%
  count(
    standardised_section,
    standardised_reporting_item_elements,
    name = "total_count"
  ) %>%
  arrange(standardised_section, desc(total_count), standardised_reporting_item_elements) %>%
  group_by(standardised_section) %>%
  group_split() %>%
  set_names(
    concept %>%
      filter(
        !is.na(standardised_section),
        !is.na(standardised_reporting_item_elements)
      ) %>%
      mutate(
        standardised_section = str_squish(as.character(standardised_section)),
        standardised_section = case_when(
          str_to_lower(standardised_section) %in% c("other", "other information") ~ "Other information",
          TRUE ~ standardised_section
        ),
        standardised_section = factor(
          standardised_section,
          levels = section_order
        ),
        standardised_reporting_item_elements =
          str_squish(as.character(standardised_reporting_item_elements))
      ) %>%
      filter(
        !is.na(standardised_section),
        standardised_reporting_item_elements != ""
      ) %>%
      count(
        standardised_section,
        standardised_reporting_item_elements,
        name = "total_count"
      ) %>%
      group_by(standardised_section) %>%
      group_keys() %>%
      pull(standardised_section) %>%
      as.character()
  ) |>
  map(~ select(.x, -standardised_section))

concept_tables_by_section

concept_tables_by_section_ordered <- concept_tables_by_section[section_order]

openxlsx::write.xlsx(
  concept_tables_by_section_ordered,
  file = file.path("data", "concept_tables_by_section.xlsx"),
  overwrite = TRUE
)
