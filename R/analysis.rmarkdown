# Total Concepts and unique concepts


```{r}
# =========================================================
# Cleveland dot plot: total vs unique concepts by section
# =========================================================

length(concept$standardised_reporting_item_elements)

section_order <- c(
  "Other information",
  "Discussion",
  "Results",
  "Methodology",
  "Introduction",
  "Abstract",
  "Title"
)

# colours chosen to complement your earlier purple plot
col_total  <- "#54478c"   # purple
col_unique <- "#048ba8"   # blue-teal
col_stem   <- "#cfc8e8"   # pale lavender connector

concept_section_summary <- concept %>%
  filter(!is.na(standardised_section)) %>%
  mutate(
    standardised_section = str_squish(as.character(standardised_section)),
    standardised_section = case_when(
      str_to_lower(standardised_section) %in% c("other", "other information") ~ "Other information",
      TRUE ~ standardised_section
    )
  ) %>%
  group_by(standardised_section) %>%
  summarise(
    total_concepts  = sum(!is.na(standardised_reporting_item_elements)),
    unique_concepts = n_distinct(
      standardised_reporting_item_elements[!is.na(standardised_reporting_item_elements)]
    ),
    .groups = "drop"
  ) %>%
  mutate(
    standardised_section = factor(
      standardised_section,
      levels = section_order
    )
  ) %>%
  filter(!is.na(standardised_section)) %>%
  arrange(standardised_section)

max_x <- max(concept_section_summary$total_concepts, na.rm = TRUE)
label_pad <- max_x * 0.04

cleveland_concepts <- ggplot(
  concept_section_summary,
  aes(y = standardised_section)
) +
  geom_segment(
    aes(
      x = unique_concepts,
      xend = total_concepts,
      yend = standardised_section
    ),
    linewidth = 2.2,
    colour = col_stem,
    lineend = "round"
  ) +
  geom_point(
    aes(x = unique_concepts, fill = "Unique concepts"),
    shape = 21,
    size = 4.6,
    stroke = 1,
    colour = "black"
  ) +
  geom_point(
    aes(x = total_concepts, fill = "Total concepts"),
    shape = 21,
    size = 4.8,
    stroke = 1,
    colour = "black"
  ) +
  geom_text(
    aes(x = unique_concepts, label = comma(unique_concepts)),
    nudge_x = -label_pad,
    nudge_y = -0.18,
    hjust = 1,
    size = 3.4,
    fontface = "bold",
    colour = col_unique
  ) +
  geom_text(
    aes(x = total_concepts, label = comma(total_concepts)),
    nudge_x = label_pad,
    nudge_y = 0.18,
    hjust = 0,
    size = 3.4,
    fontface = "bold",
    colour = col_total
  ) +
  scale_fill_manual(
    values = c(
      "Total concepts" = col_total,
      "Unique concepts" = col_unique
    ),
    breaks = c("Total concepts", "Unique concepts"),
    name = NULL
  ) +
  scale_x_continuous(
    limits = c(0, NA),
    labels = comma,
    expand = expansion(mult = c(0, 0.14))
  ) +
  coord_cartesian(clip = "off") +
  labs(
    title = "Total and unique concepts by section",
    x = "Number of concepts",
    y = "Section of the manuscript") +
  theme_minimal(base_size = 13) +
  theme(
    panel.grid.major.y = element_blank(),
    panel.grid.minor = element_blank(),
    panel.grid.major.x = element_line(color = "grey88", linewidth = 0.35),
    axis.text.y = element_text(color = "black"),
    axis.text.x = element_text(color = "black"),
    axis.title.x = element_text(color = "black", face = "bold"),
    axis.title.y = element_text(color = "black", face = "bold"),
    axis.line.x = element_line(linewidth = 0.8, color = "black"),
    axis.line.y = element_line(linewidth = 0.8, color = "black"),
    axis.ticks.y = element_blank(),
    legend.position = c(0.73, 0.18),
    legend.background = element_rect(
      fill = alpha("white", 0.9),
      colour = "grey70"
    ),
    legend.key = element_rect(fill = NA, colour = NA),
    legend.text = element_text(color = "black", size = 10.5),
    plot.title = element_text(
      size = 12.5,
      face = "bold",
      color = "black",
      hjust = 0
    ),
    plot.title.position = "plot",
    plot.margin = margin(12, 22, 12, 12)
  )

