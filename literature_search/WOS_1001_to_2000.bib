@article{ WOS:000784981500001,
Author = {Pullin, Andrew S. and Cheng, Samantha H. and Jackson, Josephine D'Urban
   and Eales, Jacqualyn and Envall, Ida and Fada, Salamatu J. and Frampton,
   Geoff K. and Harper, Meagan and Kadykalo, Andrew N. and Kohl, Christian
   and Konno, Ko and Livoreil, Barbara and Ouedraogo, Dakis-Yaoba and
   O'Leary, Bethan C. and Pullin, George and Randall, Nicola and Rees,
   Rebecca and Smith, Adrienne and Sordello, Romain and Sterling, Eleanor
   J. and Twardek, Will M. and Woodcock, Paul},
Title = {Standards of conduct and reporting in evidence syntheses that could
   inform environmental policy and management decisions},
Journal = {ENVIRONMENTAL EVIDENCE},
Year = {2022},
Volume = {11},
Number = {1},
Month = {APR 19},
Abstract = {Accurate, unbiased and concise synthesis of available evidence following
   clear methodology and transparent reporting is necessary to support
   effective environmental policy and management decisions. Without this,
   less reliable and/or less objective reviews of evidence could inform
   decision making, leading to ineffective, resource wasteful interventions
   with potential for unintended consequences. We evaluated the reliability
   of over 1000 evidence syntheses (reviews and overviews) published
   between 2018 and 2020 that provide evidence on the impacts of human
   activities or effectiveness of interventions relevant to environmental
   management. The syntheses are drawn from the Collaboration for
   Environmental Evidence Database of Evidence Reviews (CEEDER), an online,
   freely available evidence service for evidence users that assesses the
   reliability of evidence syntheses using a series of published criteria.
   We found that the majority of syntheses have problems with transparency,
   replicability and potential for bias. Overall, our results suggest that
   most recently published evidence syntheses are of low reliability to
   inform decision making. Reviews that followed guidance and reporting
   standards for evidence synthesis had improved assessment ratings, but
   there remains substantial variation in the standard of reviews amongst
   even these. Furthermore, the term `systematic review', which implies
   conformity with a methodological standard, was frequently misused. A
   major objective of the CEEDER project is to improve the reliability of
   the global body of environmental evidence reviews. To this end we
   outline freely available online resources to help improve review conduct
   and reporting. We call on authors, editors and peer reviewers to use
   these resources to ensure more reliable syntheses in the future.},
