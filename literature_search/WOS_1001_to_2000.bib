   Keenan, Ciara, Queens Univ Belfast, Belfast, Antrim, North Ireland.
   Keenan, Ciara, Campbell UK \& Ireland, Belfast, Antrim, North Ireland.},
DOI = {10.1111/aphw.12169},
EarlyAccessDate = {JUL 2019},
ISSN = {1758-0846},
EISSN = {1758-0854},
