@article{ WOS:000431109700025,
Author = {Rubio-Aparicio, Maria and Sanchez-Meca, Julio and Marin-Martinez,
   Fulgencio and Lopez-Lopez, Jose Antonio},
Title = {Guidelines for Reporting Systematic Reviews and Meta-analyses},
Journal = {ANALES DE PSICOLOGIA},
Year = {2018},
Volume = {34},
Number = {2},
Pages = {412-420},
Month = {MAY},
Abstract = {Meta-analysis is an essential methodology that allows researchers to
   synthesize the scientific evidence available on a given research
   question. Due to its wide applicability in most applied research fields,
   it is really important that meta-analyses be written and reported
   appropriately. In this paper we propose some guidelines to report the
   results of a meta-analysis in a scientific journal as Annals of
   Psychology. Concretely, the structure for reporting a meta-analysis
   following its different stages is detailed. In addition, some
   recommendations related to the usual tasks when conducting a
   meta-analysis are provided. A recent meta-analysis focused on the
   psychological field is used to illustrate the guidelines proposed.
   Finally, some concluding remarks are presented.},
