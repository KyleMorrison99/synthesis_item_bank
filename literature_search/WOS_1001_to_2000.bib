@article{ WOS:000596281800079,
Author = {Ganesh, Sri and Brar, Sheetal and Nagesh, B. N.},
Title = {Management of infectious keratitis following uneventful small-incision
   lenticule extraction using a multimodal approach - A case report},
Journal = {INDIAN JOURNAL OF OPHTHALMOLOGY},
Year = {2020},
Volume = {68},
Number = {12},
Pages = {3064+},
Month = {DEC},
Abstract = {A 42-year-old female presented with pain, photophobia, and superficial
   corneal infiltrates in mid-periphery in the left eye, after 2 days of
   uneventful bilateral SMILE procedure. Inspite of the medical treatment
   with fortified antibiotics, the infection spread to the interface, close
   to visual axis reducing UDVA from 20/16 to 20/80. Immediate surgical
   intervention in the form of scraping of interface lesions with 26G
   needle, interface wash with antibiotics and photoactivated chromophore
   for keratitis (PACK-CXL) was performed. After 24 h of bacterial culture
   Staphylococcus aureus was yielded. Interface wash and PACK-CXL was
   repeated after 48 h by which infiltrates reduced and early scarring was
   observed by 10(th) post-op day. Subsequent topical steroids helped in
   limiting scar formation and UDVA improved to 20/30 at the final visit.
   Combined approach of interface wash with antibiotics and PACK-CXL may be
   a safe and effective modality in treating early onset infectious
   keratitis following SMILE surgery.},
