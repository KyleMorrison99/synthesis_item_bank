@article{ WOS:001154781600001,
Author = {Zywicka, Ewa M. and McNally, Eleanor and Elliott, Lucy and Twine,
   Christopher P. and Mouton, Ronelle and Hinchliffe, Robert J.},
Title = {Exploring the Reporting Standards of Randomised Controlled Trials
   Involving Endovascular Interventions for Peripheral Arterial Disease: A
   Systematic Review},
Journal = {EUROPEAN JOURNAL OF VASCULAR AND ENDOVASCULAR SURGERY},
Year = {2024},
Volume = {67},
Number = {1},
Pages = {155-164},
Month = {JAN},
Abstract = {This systematic review provides a summary of the quality of reporting
   standards of endovascular interventions for the treatment of patients
   with peripheral arterial disease. Randomised controlled trials
   investigating endovascular procedures are limited by inadequate
   reporting, poor intervention description, and stand-ardisation. Of the
   included studies, 21\% described the procedures well enough to allow
   replication and 22\% reported a degree of standardisation across all
   participants. Inadequate reporting of invasive procedures hampers
   reproducibility, hinders evidence based practice, and potentially
   compromises patient safety. The description of endovascular
   interventions in randomised control trials requires urgent improvement.},
