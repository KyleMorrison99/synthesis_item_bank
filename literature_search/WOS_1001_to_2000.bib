@article{ WOS:001470417600005,
Author = {Gigolaev, German},
Title = {Publications on Cold War History on the Pages of the RSUH/RGGU Bulletin:
   in Search of New Approaches and Research Practices},
Journal = {ISTORIYA-ELEKTRONNYI NAUCHNO-OBRAZOVATELNYI ZHURNAL},
Year = {2024},
Volume = {15},
Number = {12, 2},
Abstract = {This article explores the evolution of methodologies in Cold War history
   research, drawing from previously published materials in the journal
   ``RSUH/RGGU Bulletin. Series << Political Science. History.
   International Relations >>{''}. The author emphasizes application of
   innovative research methods, such as the history of emotions, and the
   integration of unconventional historical sources, including video games.
   This is made possible by the journal's interdisciplinary approach, which
   combines contributions from historians and political scientists,
   fostering a multiparadigmatic perspective in Cold War studies. The
   thematic issues dedicated to the Cold War are particularly noteworthy
   for their efforts to move beyond traditional historiography, focusing on
   the influence of crisis events and the relevance of Cold War experiences
   for history of international relations. The article argues that an
   interdisciplinary approach is essential for a deeper understanding of
   international relations during the Cold War. The author asserts that the
   diversity of methodological approaches and the multiparadigmatic nature
   of the studies significantly enhance both Russian and international Cold
   War historiography. Furthermore, the article highlights the pivotal role
   of ``RSUH/RGGU Bulletin. Series << Political Science. History.
   International Relations >>{''} in establishing an academic framework for
   Cold War studies and its contribution to the development of the
   scholarly community.},
