@article{ WOS:001236453400009,
Author = {Hirt, Julian and Nordhausen, Thomas and Fuerst, Thomas and Ewald, Hannah
   and Appenzeller-Herzog, Christian and TARCiS study grp},
Title = {Guidance on terminology, application, and reporting of citation
   searching: the TARCiS statement},
Journal = {BMJ-BRITISH MEDICAL JOURNAL},
Year = {2024},
Volume = {385},
Month = {MAY 9},
Abstract = {Evidence syntheses adhering to systematic literature searching
   techniques are a cornerstone of evidence based healthcare. Beyond term
   based searching in electronic databases, citation searching is a
   prevalent search technique to identify relevant sources of evidence.
   However, for decades, citation searching methodology and terminology has
   not been standardised. An evidence guided, four round Delphi consensus
   study was conducted with 27 international methodological experts in
   order to develop the Terminology, Application, and Reporting of Citation
   Searching (TARCiS) statement. TARCiS comprises 10 specific
   recommendations, each with a rationale and explanation on when and how
   to conduct and report citation searching in the context of systematic
   literature searches. The statement also presents four research
   priorities, and it is hoped that systematic review teams are encouraged
   to incorporate TARCiS into standardised workflows.},
