@article{ WOS:001499290300002,
Author = {Shuang, Kai and Zhou, Ji and Wang, Qiwei and Qian, Bing and Wei, Yunhao
   and Guo, Jinyu},
Title = {Utilizing contextual summarizing and reasoning for enhancing
   document-level event argument extraction},
Journal = {EXPERT SYSTEMS WITH APPLICATIONS},
Year = {2025},
Volume = {287},
Month = {AUG 25},
Abstract = {There are many event associations in long-range documents. However, the
   event features modeled by most document-level event argument extraction
   (D-EAE) methods contain too many redundant event contexts while ignoring
   critical event association information. This paper presents a novel
   document-level event argument extraction framework based on contextual
   summarizing and reasoning (ECSR), which utilizes the emergent
   capabilities of large language models to generate task-relevant
   supplementary information to solve key feature forgetting and
   cross-event argument confusion challenges in the D-EAE task.
   Specifically, ECSR generates the summarizing information, which can
   reduce a large amount of redundant, non-critical event contexts so that
   the key feature forgetting challenge can be solved. ECSR generates event
   correlation and entity information, which can provide explicit guidance
   for the EAE model to extract event arguments, thus solving the
   cross-event argument confusion challenge and achieving promising results
   in the few-shot EAE task as well. Based on ECSR, we design two event
   argument extraction methods: the ECSRspan and the ECSRprompt. Extensive
   experiments on two popular D-EAE datasets show that ECSR achieves a new
   SOTA, which exceeds the baseline model by 2.1 \% F1 and 2.4\% F1,
   respectively, and averages 11\% F1 in few-shot settings.},
