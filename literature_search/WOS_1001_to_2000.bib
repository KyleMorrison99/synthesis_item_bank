@article{ WOS:001446339300001,
Author = {Liu, Bao and Qi, Guilin},
Title = {Document-level relation extraction with Double graph guidance for
   long-tailed distributions},
Journal = {COMPUTERS \& ELECTRICAL ENGINEERING},
Year = {2025},
Volume = {123},
Number = {D},
Month = {APR},
Abstract = {Document-level relation extraction (DocRE) aims to predict the semantic
   relationships between entity pairs that are expressed across multiple
   sentences. Existing methods employ explicit or implicit strategies to
   capture the cross-sentence, long-distance information between entity
   pairs. However, these models often struggle with the long-tailed
   distribution problem that is common in DocRE datasets. To address this
   challenge, we propose a DocRE model with double graph guidance.
   Specifically, we construct a document graph to connect all entities in
   the document and obtain their long-distance information. In addition, a
   constraint graph is introduced to connect different relations through
   entity types, allowing the propagation of useful information between
   them and enhancing the extraction of long-tailed relations. Finally, we
   design an entity information fusion module to enrich the entity pair
   embeddings by incorporating additional features, such as long-distance
   dependencies, relations, and entity types. Extensive experiments on two
   widely used datasets demonstrate that the proposed model outperforms
   existing competitive baselines, achieving an improvement of at least
   1.45\% in the Ign F1 metric.},
Publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
