   Baltatzis, M.; Chan, A. K. C.; Jegatheeswaran, S.; Siriwardena, A. K., Manchester Royal Infirm, Hepatopancreatobiliary Surg Unit, Oxford Rd, Manchester M13 9WL, Lancs, England.
   Mason, J. M., Univ Durham, Sch Med Pharm \& Hlth, Durham, England.},
DOI = {10.1016/j.ejso.2015.11.002},
