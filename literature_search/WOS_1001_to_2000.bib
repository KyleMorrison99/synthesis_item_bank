@article{ WOS:000417550400015,
Author = {Motte, Anne-France and Diallo, Stephanie and van den Brink, Helene and
   Chateauvieux, Constance and Serrano, Carole and Naud, Carole and
   Steelandt, Julie and Alsac, Jean-Marc and Aubry, Pierre and Cour,
   Florence and Pellerin, Olivier and Pineau, Judith and Prognon, Patrice
   and Borget, Isabelle and Bonan, Brigitte and Martelli, Nicolas},
Title = {Existing reporting guidelines for clinical trials are not completely
   relevant for implantable medical devices: a systematic review},
Journal = {JOURNAL OF CLINICAL EPIDEMIOLOGY},
Year = {2017},
Volume = {91},
Pages = {111-120},
Month = {NOV},
Abstract = {Objectives: The aim of this study was to determine relevant items for
   reporting clinical trials on implantable medical devices (IMDs) and to
   identify reporting guidelines which include these items.
   Study Design and Setting: A panel of experts identified the most
   relevant items for evaluating IMDs from an initial list based on
   reference papers. We then conducted a systematic review of articles
   indexed in MEDLINE. We retrieved reporting guidelines from the EQUATOR
   network's library for health research reporting. Finally, we screened
   these reporting guidelines to find those using our set of reporting
   items.
   Results: Seven relevant reporting items, were selected that related to
   four topics: randomization, learning curve, surgical setting, and device
   information. A total of 348 reporting guidelines were identified, among
   which 26 met our inclusion criteria. However, none of the 26 reporting
   guidelines presented all seven items together. The most frequently
   reported item was timing of randomization (65\%). On the contrary,
   device information and learning curve effects were poorly specified.
   Conclusion: To our knowledge, this study is the first to identify
   specific items related to IMDs in reporting guidelines for clinical
   trials. We have shown that no existing reporting guideline is totally
   suitable for these devices. (C) 2017 Elsevier Inc. All rights reserved.},
