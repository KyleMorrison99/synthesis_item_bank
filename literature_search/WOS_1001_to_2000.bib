Editor = {Nguyen, NT and Hoang, BH and Huynh, CP and Hwang, D and Trawinski, B and Vossen, G},
Title = {Approach to Extract Keywords and Keyphrases of Text Resources and
   Documents in the Kazakh Language},
Booktitle = {COMPUTATIONAL COLLECTIVE INTELLIGENCE, ICCCI 2020},
Series = {Lecture Notes in Artificial Intelligence},
