   Catalano, Silvia and Surace, Alessandra and Marola, Silvia and Gentile,
   Valentina and Martino, Valter and Solej, Mario and Nano, Mario},
Title = {Percutaneous drainage and sclerosis of mesenteric cysts: Literature
   overview and report of an innovative approach},
Journal = {INTERNATIONAL JOURNAL OF SURGERY},
Year = {2014},
Volume = {12},
Number = {2},
Pages = {S90-S93},
Month = {OCT},
Abstract = {We present the case of a 29-years-old male patient, affected by a
   voluminous post-traumatic mesenteric cyst, a rare abdominal disease; our
   patient represents a rarely affected age group.
   Treatment was based on interventional radiology with an US-guided
   drainage and sclerosis by ethyl alcohol of the lesion.
   The intervention performed on this patient represents the application of
   a standardized radiological technique to a new contest, mesenteric
   cysts, whose gold-standard treatment is represented in literature by
   surgery.
   In our case we obtained an optimal result, with complete regression of
   the treated cyst: it proved to be an effective, feasible, safe and
   minimally invasive procedure. (C) 2014 Surgical Associates Ltd.
