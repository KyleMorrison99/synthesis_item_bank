@article{ WOS:000384225800087,
Author = {Zhao, Yu and Fan, Bingfeng and Chen, Yiting and Zhuo, Yi and Pang,
   Zhoujun and Liu, Zhen and Wang, Gang},
Title = {Enhanced light extraction of GaN-based light-emitting diodes with
   periodic textured SiO2 on Al-doped ZnO transparent conductive
   layer},
Journal = {CHINESE PHYSICS B},
Year = {2016},
Volume = {25},
Number = {7},
Month = {JUL},
Abstract = {We report an effective enhancement in light extraction of GaN-based
   light-emitting diodes (LEDs) with an Al-doped ZnO (AZO) transparent
   conductive layer by incorporating a top regular textured SiO2 layer. The
   2 inch transparent throughpore anodic aluminum oxide (AAO) membrane was
   fabricated and used as the etching mask. The periodic pore with a pitch
   of about 410 nm was successfully transferred to the surface of the SiO2
   layer without any etching damages to the AZO layer and the electrodes.
   The light output power was enhanced by 19\% at 20 mA and 56\% at 100 mA
   compared to that of the planar LEDs without a patterned surface. This
   approach offers a technique to fabricate a low-cost and large-area
   regular pattern on the LED chip for achieving enhanced light extraction
   without an obvious increase of the forward voltage.},
