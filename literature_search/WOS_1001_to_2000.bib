Address = {236 GRAYS INN RD, FLOOR 6, LONDON WC1X 8HL, ENGLAND},
Type = {Review},
Language = {English},
Affiliation = {Chiara, O (Corresponding Author), Niguarda Granda Hosp, Niguarda Trauma Ctr, Trauma Team \& Emergency Surg, Piazza Osped Maggiore 3, I-20162 Milan, Italy.
   Sorrentino, Luca; Chiara, Osvaldo; Sammartano, Fabrizio; Cimbanassi, Stefania, Niguarda Granda Hosp, Niguarda Trauma Ctr, Trauma Team \& Emergency Surg, Piazza Osped Maggiore 3, I-20162 Milan, Italy.
