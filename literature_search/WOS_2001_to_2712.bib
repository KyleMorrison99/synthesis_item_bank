@article{ WOS:000188001000006,
Author = {Ruckdeschel, K and Thompson, R and Datto, CJ and Streim, JE and Katz, IR},
Title = {Using the Minimum Data Set 2.0 mood disturbance items as a self-report
   screening instrument for depression in nursing home residents},
