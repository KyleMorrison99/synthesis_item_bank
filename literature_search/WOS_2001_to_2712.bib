@article{ WOS:A1995QV57500031,
Author = {PFEIFER, U and FUHR, N and HUYNH, T},
Title = {SEARCHING STRUCTURED DOCUMENTS WITH THE ENHANCED RETRIEVAL FUNCTIONALITY
   OF FREE WAIS-SF AND SFGATE},
Journal = {COMPUTER NETWORKS AND ISDN SYSTEMS},
Year = {1995},
Volume = {27},
Number = {6},
Pages = {1027-1036},
Month = {APR},
Note = {3rd International World-Wide Web Conference, DARMSTADT, GERMANY, APR
   10-14, 1995},
Abstract = {The original WAIS implementation by Thinking Machines et al. treats
   documents as uniform bags of terms. Since most documents exhibit some
   internal structure, it is desirable to provide the user means to exploit
   this structure in his queries. In this paper, we present extensions to
   the freeWAIS(4,5) indexer and server, which allow access to document
   structures using the original WAIS protocol.
   Major extensions include: arbitrary document formats, search in
   individual structure elements, stemming and phonetic search, support of
   8-bit character sets, numeric concepts and operators, combination of
   Boolean and linear retrieval.
   We also present a WWW-WAIS gateway specially tailored for usage with
   freeWAIS-sf {[}1], which transforms filled-out HTML forms to the new
   query syntax.},
Publisher = {ELSEVIER SCIENCE BV},
Address = {PO BOX 211, 1000 AE AMSTERDAM, NETHERLANDS},
