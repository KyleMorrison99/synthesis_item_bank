Editor = {Park, JC and Arase, Y and Hu, B and Lu, W and Wijaya, D and Purwarianti, A and Krisnadhi, AA},
Title = {PRiSM: Enhancing Low-Resource Document-Level Relation Extraction with
   Relation-Aware Score Calibration},
Booktitle = {13TH INTERNATIONAL JOINT CONFERENCE ON NATURAL LANGUAGE PROCESSING AND
   THE 3RD CONFERENCE OF THE ASIA-PACIFIC CHAPTER OF THE ASSOCIATION FOR
   COMPUTATIONAL LINGUISTICS, IJCNLP-AACL 2023},
