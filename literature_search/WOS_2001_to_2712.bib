@article{ WOS:000088855000004,
Author = {Filipek, PA and Accardo, PJ and Ashwal, S and Baranek, GT and Cook, EH
   Jr and Dawson, G and Gordon, B and Gravel, JS and Johnson, CP and
   Kallen, RJ and Levy, SE and Minshew, NJ and Ozonoff, S and Prizant, BM
   and Rapin, I and Rogers, SJ and Stone, WL and Teplin, SW and Tuchman, RF
   and Volkmar, FR},
Title = {Practice parameter: Screening and diagnosis of autism - Report of the
   Quality Standards Subcommittee of the American Academy of Neurology and
   the Child Neurology Society},
Journal = {NEUROLOGY},
Year = {2000},
Volume = {55},
Number = {4},
Pages = {468-479},
Month = {AUG 22},
Abstract = {Autism is a common disorder of childhood, affecting 1 in 500 children.
   Yet, it often remains unrecognized and undiagnosed until or after late
   preschool age because appropriate tools for routine developmental
   screening and screening specifically for autism have not been available.
   Early identification of children with autism and intensive, early
   intervention during the toddler and preschool years improves outcome for
   most young children with autism. This practice parameter reviews the
   available empirical evidence and gives specific recommendations for the
   identification of children with autism. This approach requires a dual
   process: 1) routine developmental surveillance and screening
   specifically for autism to be performed on all children to first
   identify those at risk for any type of atypical development, and to
   identify those specifically at risk for autism; and 2) to diagnose and
   evaluate autism, to differentiate autism from other developmental
   disorders.},
