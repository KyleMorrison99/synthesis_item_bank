DOI = {10.1016/0306-4573(94)90068-X},
ISSN = {0306-4573},
Keywords-Plus = {RETRIEVAL PERFORMANCE; RELEVANCE FEEDBACK; INFORMATION},
Research-Areas = {Computer Science; Information Science \& Library Science},
