@article{ WOS:000253571900016,
Author = {Kemner, Chantal and Van Ewijk, Lizet and Van Engeland, Herman and Hooge,
   Ignace},
Title = {Brief report: Eye movements during visual search tasks indicate enhanced
   stimulus discriminability in subjects with PDD},
Journal = {JOURNAL OF AUTISM AND DEVELOPMENTAL DISORDERS},
Year = {2008},
Volume = {38},
Number = {3},
Pages = {553-557},
Month = {MAR},
Abstract = {Subjects with PDD excel on certain visuo-spatial tasks, amongst which
   visual search tasks, and this has been attributed to enhanced perceptual
   discrimination. However, an alternative explanation is that subjects
   with PDD show a different, more effective search strategy. The present
   study aimed to test both hypotheses, by measuring eye movements during
   visual search tasks in high functioning adult men with PDD and a control
   group. Subjects with PDD were significantly faster than controls in
   these tasks, replicating earlier findings in children. Eye movement data
   showed that subjects with PDD made fewer eye movements than controls. No
   evidence was found for a different search strategy between the groups.
   The data indicate an enhanced ability to discriminate between stimulus
   elements in PDD.},
