@inproceedings{ WOS:000886782800003,
Author = {Wang, Xinyi and Wang, Zitao and Sun, Weijian and Hu, Wei},
Editor = {Sattler, U and Hogan, A and Keet, M and Presutti, V and Almeida, JPA and Takeda, H and Monnin, P and Pirro, G and DAmato, C},
Title = {Enhancing Document-Level Relation Extraction by Entity Knowledge
   Injection},
Booktitle = {SEMANTIC WEB - ISWC 2022},
Series = {Lecture Notes in Computer Science},
Year = {2022},
Volume = {13489},
Pages = {39-56},
Note = {21st International Semantic Web Conference (ISWC), ELECTR NETWORK, OCT
   23-27, 2022},
Organization = {ChinaScope; Elsevier; IBM Res; Metaphacts; MEMECT; Oracle; Springer},
Abstract = {Document-level relation extraction (RE) aims to identify the relations
   between entities throughout an entire document. It needs complex
   reasoning skills to synthesize various knowledge such as coreferences
   and commonsense. Large-scale knowledge graphs (KGs) contain a wealth of
   real-world facts, and can provide valuable knowledge to document-level
   RE. In this paper, we propose an entity knowledge injection framework to
   enhance current document-level RE models. Specifically, we introduce
   coreference distillation to inject coreference knowledge, endowing an RE
   model with the more general capability of coreference reasoning. We also
   employ representation reconciliation to inject factual knowledge and
   aggregate KG representations and document representations into a unified
   space. The experiments on two benchmark datasets validate the
   generalization of our entity knowledge injection framework and the
   consistent improvement to several document-level RE models.},
