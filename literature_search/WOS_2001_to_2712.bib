@article{ WOS:000807974800001,
Author = {Lian, Mengying and Huang, Yiqing and Liu, Yang and Jiang, Dawei and Wu,
   Zijian and Li, Bin and Xu, Qiang and Murugadoss, Vignesh and Jiang,
   Qinglong and Huang, Mina and Guo, Zhanhu},
Title = {An overview of regenerable wood-based composites: preparation and
   applications for flame retardancy, enhanced mechanical properties,
   biomimicry, and transparency energy saving},
Journal = {ADVANCED COMPOSITES AND HYBRID MATERIALS},
Year = {2022},
Volume = {5},
Number = {3},
Pages = {1612-1657},
Month = {SEP},
Abstract = {With the increasing awareness of environmental protection and demand for
   smart homes and high-performance composites, how to reduce the cost and
   improve their mechanical properties by using all-green basic structural
   blocks to meet the needs of practical applications remains challenging
   for wood-based composites. Here, this review explores four different
   renewable wood-based composites, where their fabrication methods and
   mechanisms, fabrication processes, and their applications are described
   in this review, including (1) flame-retardant wood-based composites, (2)
   wood-based composites with enhanced mechanical properties,
   hydrophobicity, frost resistance and excellent tensile properties, (3)
   transparency energy saving wood-based composites, and (4) biomimetic
   wood-based composites. Their manufacturing methods and characteristics
   are respectively discussed in details. Meanwhile, the emerging
   application prospects of different regenerable wood-based composites in
   industrial activities and construction production are also introduced.
   This review not only provides valuable information to fabricate
   wood-based composites with regenerable methods, but also directs the
   future development of wood-based composites.},
