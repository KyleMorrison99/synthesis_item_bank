Language = {English},
Affiliation = {Savchenko, J (Corresponding Author), Dept Obstet \& Gynaecol, Sjukhusbacken 10, S-11883 Stockholm, Sweden.
   Savchenko, Julia; Lindqvist, Pelle G., Stockholm South Gen Hosp Sodersjukhuset, Dept Obstet \& Gynaecol, Stockholm, Sweden.
