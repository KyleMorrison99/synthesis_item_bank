Title = {Conducting a test adequacy criterion with sequential approach},
Booktitle = {SOFTWARE QUALITY ENGINEERING},
Year = {1997},
Pages = {247-256},
Note = {1st International Conference on Software Quality Engineering (SQE 97),
   UDINE, ITALY, MAY, 1997},
Organization = {Univ Udine, Italy; Wessex Inst Technol; Assoc Italiana Calcolo
   Automatico; GR INF CEDES \& HERMES SOFTLAB},
Abstract = {The concern of this paper is to conduct a testing action which
   considering whether a program has been tested enough. We first propose a
   quantitative analysis basis to measure the difference of testing effort
   between different testing criteria. A theoretical basis for measuring
   testing efforts for selecting testing criteria is provided. Besides, a
   testing action with sequential approach is also proposed. The basic idea
   is to use a base set of test data that cover all statements, and then
   add new test data, one at a time, to cover the remaining untested edges.
   The proposed formula is used to determine if it is possible to stop
   testing before all edges be tested. The proposed theoretical analysis
   basis will be a reasonable guideline for software developers to select a
   proper testing action.},
