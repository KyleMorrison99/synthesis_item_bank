@article{ WOS:A1995RQ42600003,
Author = {DOPFNER, M and BERNER, W and LEHMKUHL, G},
Title = {RELIABILITY AND FACTORIAL VALIDITY OF THE YOUTH SELF-REPORT OF THE
   CHILD-BEHAVIOR CHECKLIST IN A CLINICAL-SAMPLE},
Journal = {DIAGNOSTICA},
Year = {1995},
Volume = {41},
Number = {3},
Pages = {221-244},
Abstract = {This study examined the reliability (internal consistency), the
   correlations between the scale scores, and the factorial validity of the
   German Version of the Youth Self-Report (YSR), which is a self-report
   questionnaire for 11- to 18-yearold adolescents derived from the Child
   Behavior Checklist (CBCL). The analyses were based on a sample of
   patients in a child and adolescent psychiatric hospital (N = 2921. The
   internal consistencies of the total score and the Externalizing and
   Internalizing groupings are at least satisfactory (r(tt) > .80). Apart
   from the syndrome scales `'Withdrawn'' and `'Thought Problems'', the
   reliabilities of the syndrome scales are satisfactory (r(tt) > .70). The
   internal consistencies of the syndrome scales of the German and the
   American samples are comparable. The intercorrelations of the scales are
   generally relatively low or moderate. The structure of the syndrome
   scales was confirmed by factor analyses, except for the scale
   `'Withdrawn''. Corn parisons with a clinical sample from the United
   States show high correspondences of the scale scores in some cases.},
