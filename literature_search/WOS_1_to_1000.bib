@article{ WOS:001305883800009,
Author = {Greer, David M. and Lewis, Ariane and Kirschen, Matthew P.},
Title = {Author Response: Pediatric and Adult Brain Death/Death by Neurologic
   Criteria Consensus Guideline: Report of the AAN Guidelines Subcommittee,
   AAP, CNS, and SCCM},
Journal = {NEUROLOGY},
Year = {2024},
Volume = {102},
Number = {9},
Month = {MAY 14},
Abstract = {We appreciate Dr. Feldman's comments regarding the importance of
   accounting for residual confounding drug effects in brain death/death by
   neurologic criteria (BD/DNC) determination in the setting of poisoning
   and overdose, an increasingly common problem due to the public health
   epidemic. We agree that this is a specific circumstance that requires
   extreme diligence to avoid false-positive determinations. The 2023
   guidelines emphasize that a ``lack of meticulous attention to stringent
   guidelines could lead to inappropriate or inaccurate diagnosis of
   BD/DNC.{''}1 A notable addition to the 2023 guidelines is the
   recommendation that ``clinicians should determine that neuroimaging is
   consistent with the mechanism and severity of brain injury{''}
   (Recommendation 7c), which is aimed to ensure that, even in the setting
   of poisoning or overdose, structural evidence of a neurologic
   catastrophe consistent with cerebral circulatory arrest was present.
   Throughout the guidelines, a patient and conservative approach is
   emphasized: ``Clinicians must wait a sufficient amount of time after the
   brain injury occurs before initiating the BD/DNC evaluation to ensure
   there is no potential for recovery of brain function.{''}
   (Recommendation 9a) Although a minimum observation period is specified
   in the setting of hypoxic-ischemic brain injury, there is no maximum
   waiting period, and it is clearly prudent to wait longer in the setting
   of drug intoxication or poisoning. Of note, the American College of
   Medical Toxicology 2017 statement is referenced in the 2023 guidelines.2
   Toxicology results are required to be negative (Recommendation 12a), and
   clearance of known medications or intoxicants is specifically required,
   including in the setting of hepatic/renal dysfunction, hypothermia, or
   obesity, all of which could affect metabolism and clearance. In
   addition, a new addition to the 2023 guidelines is a useful guide for
   practitioners regarding half-lives of specific medications (eTable 2).
   Finally, ancillary testing is required in the setting of inability to
   adequately correct metabolic derangements or other confounders, provided
   that the neurologic examination(s) and apnea test(s) are consistent with
   BD/DNC (Recommendation statement 12b). Dr. Feldman's point that
   toxicologists be consulted is excellent, and we would also encourage
   collaboration with clinical pharmacologists to rule out the effect of
   medication/drug confounders before BD/DNC evaluation. Unfortunately, the
   identity and amount of recreational drugs taken in the setting of
   overdose are often unknown and may not be detected by routine toxicology
   screens. Once again, in this setting we emphasize the importance of a
   more prolonged observation period, supportive neuroimaging, and
   ancillary testing to guard against misdiagnosis.},
Publisher = {LIPPINCOTT WILLIAMS \& WILKINS},
