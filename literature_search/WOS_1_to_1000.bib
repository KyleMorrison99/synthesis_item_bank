@article{ WOS:001305883800017,
Author = {Lewis, Ariane and Kirschen, Matthew P. and Greer, David M.},
Title = {Author Response: Pediatric and Adult Brain Death/Death by Neurologic
   Criteria Consensus Guideline: Report of the AAN Guidelines Subcommittee,
   AAP, CNS, and SCCM},
Journal = {NEUROLOGY},
Year = {2024},
Volume = {102},
Number = {9},
Month = {MAY 14},
Abstract = {Although brain death/death by neurologic criteria (BD/DNC) is accepted
   as both medical and legal death throughout the United States and much of
   the world, there are varying conceptual, religious, cultural, and social
   views about use of this criterion for death.1 While DeCock et al.
   believe that ``actual brain death{''} does not occur until there is
   evidence of liquefactive necrosis, BD/DNC determination around the world
   relies on clinical evaluation to assess for coma, loss of brainstem
   reflexes, and inability to breathe spontaneously in the setting of an
   adequate stimulus.2 The ``Pediatric and Adult Brain Death/Death by
   Neurologic Criteria Consensus Guideline{''}3 is consistent with the
   guidelines for BD/DNC evaluation created by the World Brain Death
   Project in 2020 (which was endorsed by 5 world federations) and the
   Canadian guidelines for determination of death, which were also updated
   in 2023.4,5 All 3 use the term ``permanent{''} to describe loss of brain
   functions necessary to declare death and specifically note that evidence
   of neuroendocrine function does not preclude BD/DNC determination. The
   rationale for use of the term ``permanent{''} as compared with
   ``irreversible{''} and explanations of why loss of neuroendocrine
   function is not required for BD/DNC determination are included in both
   the guideline article and other recent publications.6-9},
