@article{ WOS:000349022200002,
Author = {Singh, Jay P. and Yang, Suzanne and Mulvey, Edward P. and RAGEE Grp},
Title = {Reporting Guidance for Violence Risk Assessment Predictive Validity
   Studies: The RAGEE Statement},
Journal = {LAW AND HUMAN BEHAVIOR},
Year = {2015},
Volume = {39},
Number = {1},
Pages = {15-22},
Month = {FEB},
Abstract = {Available reporting guidelines for prognostic and diagnostic accuracy
   studies apply primarily to biological assessment and outcomes,
   overlooking behavioral issues with major public health and safety
   implications such as violence. The present study aimed to develop the
   first set of reporting guidance for predictive validity studies of
   violence risk assessments: the Risk Assessment Guidelines for the
   Evaluation of Efficacy (RAGEE) Statement. A systematic search of 8
   electronic databases prior to September 2012 identified 279 reporting
   guidelines for prognostic and diagnostic accuracy studies. Unique items
   were extracted and modified to make them relevant to risk assessment. A
   4-wave Delphi process involving a multidisciplinary team of 37
   international experts resulted in a 50-item reporting checklist. The
   panelists endorsed the RAGEE Statement checklist as being highly
   satisfactory and as indicating study features that should be reported
   routinely in manuscripts. Use of these proposed standards has the
   potential to improve the quality of the risk assessment literature.},
