@article{ WOS:000460419000006,
Author = {Maritz, Roxanne and Tennant, Alan and Fellinghauer, Carolina and Stucki,
   Gerold and Prodinger, Birgit and Buetzberger, Stefan and Ernst, Dieter
   and Waegli, Juerg and Rabito, Giovanni and Foiada, Sandro and Walther,
   Nicolas and Engelter, Stefan and De Waele, Els and Ritter, Beat and
   Fleisch-Silvestri, Ruth and Bachmann, Stefan and Blanco, Javier and
   Hund-Georgiadis, Margret and Hermann, Matthias and Bongetta, Michele and
   Kuchynka, Jan and Altmann, Serge and NRP74 StARS Clin},
Title = {THE FUNCTIONAL INDEPENDENCE MEASURE 18-ITEM VERSION CAN BE REPORTED AS A
   UNIDIMENSIONAL INTERVAL-SCALED METRIC: INTERNAL CONSTRUCT VALIDITY
   REVISITED},
Journal = {JOURNAL OF REHABILITATION MEDICINE},
Year = {2019},
Volume = {51},
Number = {3},
Pages = {193-200},
Month = {MAR},
Abstract = {Objective: Since the 1990s the Functional Independence Measure (FIM
   (TM)) was believed to measure 2 different constructs, represented by its
   motor and cognitive subscales. The practice of reporting FIM (TM) total
   scores, together with recent developments in the understanding of the
   influence of locally dependent items on fit to the Rasch model, raises
   the question of whether the FIM (TM) 18-item version can be reported as
   a unidimensional interval-scaled metric.
   Design: Rasch analysis of the FIM (TM) using testlet approaches to
   accommodate local response dependency.
   Patients: A calibration sample containing 946 cases of data from 11,103
   patients undergoing neurological or musculoskeletal rehabilitation in
   Switzerland in 2016.
   Results: Baseline analysis and the traditional testlet approach showed
   no fit with the Rasch model. When items were grouped into 2 testlets,
   fit to the Rasch model was achieved, indicating unidimensionality across
   all 18 items. A transformation table to convert FIM (TM) raw ordinal
   scores to the corresponding Rasch interval scaled values was created.
   Conclusion: This study provides evidence that FIM (TM) total scores
   represent a unidimensional set of items, supporting their use in
   clinical practice and outcome reporting when applying the respective
   transformation table. This provides a basis for standardized reporting
   of functioning.},
