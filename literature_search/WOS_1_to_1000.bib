   Schmidt, Kornelius; Enge, Soren; Miller, Robert, Tech Univ Dresden, Fac Psychol, Zellescher Weg 19, D-01069 Dresden, Germany.
   Enge, Soren, Med Sch Berlin, Fac Nat Sci, Dept Psychol, Berlin, Germany.},
DOI = {10.1037/pas0000829},
ISSN = {1040-3590},
EISSN = {1939-134X},
Keywords = {multidimensional item response theory; chronic stress; depressiveness;
   neuroticism; fatigue; hair cortisol},
