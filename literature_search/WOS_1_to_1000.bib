@article{ WOS:000639973300001,
Author = {Abdel-Aziz, Aly A. and Ahmed, Khaled H. and Massoud, Ahmed M. and
   Williams, Barry W.},
Title = {Unaligned inductance calculation using flux tube approach for rotor
   conducting screen-based SRM},
Journal = {IET ELECTRIC POWER APPLICATIONS},
Year = {2021},
Volume = {15},
Number = {8},
Pages = {1081-1094},
Month = {AUG},
Abstract = {This article investigates the effect of utilising rotor conducting
   screens within a switched reluctance machine (SRM). Conducting,
   non-magnetic materials such as aluminium or copper are inserted into the
   interpole regions of the rotor. The effective unaligned inductance
   decreases, which increases the conversion area allowing the machine to
   develop more power. Predicting machine performance implies knowing the
   value of the unaligned inductance. A procedure for calculating the
   effective unaligned inductance for screened motors using the flux tube
   method is presented. Finite element analysis results establish the
   validity of the proposed calculation method. A detailed design procedure
   for screened SRM is presented.},
