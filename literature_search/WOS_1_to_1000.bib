@article{ WOS:A1992KC31900001,
Author = {SCHNITT, SJ and CONNOLLY, JL and TAVASSOLI, FA and FECHNER, RE and
   KEMPSON, RL and GELMAN, R and PAGE, DL},
Title = {INTEROBSERVER REPRODUCIBILITY IN THE DIAGNOSIS OF DUCTAL PROLIFERATIVE
   BREAST-LESIONS USING STANDARDIZED CRITERIA},
Journal = {AMERICAN JOURNAL OF SURGICAL PATHOLOGY},
Year = {1992},
Volume = {16},
Number = {12},
Pages = {1133-1143},
Month = {DEC},
Abstract = {Although the categorization of proliferative breast lesions provides
   valuable information regarding subsequent risk of breast cancer, the
   ability of pathologists to classify such lesions in a reproducible
   fashion has not been adequately evaluated. To assess further
   interobserver reproducibility in the categorization of proliferative
   breast lesions, six pathologists each reviewed 24 proliferative ductal
   lesions and classified them as either usual hyperplasia (H), atypical
   hyperplasia (AH), or carcinoma in situ (CIS). Before evaluation of the
   study slides, all the participants were instructed to use the diagnostic
   criteria of Page and co-workers and were provided with both a written
   summary of these criteria and a set of teaching slides with
   representative examples of each type of lesion. Complete agreement among
   all six pathologists was seen in 14 cases (58\%); five or more agreed in
   17 cases (71\%); and four or more arrived at the same diagnosis in 22
   cases (92\%). No pathologist consistently rendered more ``benign{''} or
   ``malignant{''} diagnoses than any other. After assigning numerical
   values for each diagnostic category (H = 1, AH = 2, CIS = 3), the scores
   for the group of 24 cases did not differ significantly by pathologist (p
   = 0.68; average score range, 1.7-2.0). Our results indicate that with
   the use of standardized criteria, interobserver concordance in the
   diagnosis of proliferative ductal breast lesions can be obtained in the
   majority of cases.},
