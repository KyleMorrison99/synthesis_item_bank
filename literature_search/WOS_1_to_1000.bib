@article{ WOS:000228234400009,
Author = {Ülkü, R and Baskan, Z and Yavuz, I},
Title = {Open surgical approach for a tooth aspirated during dental extraction: A
   case report},
Journal = {AUSTRALIAN DENTAL JOURNAL},
Year = {2005},
Volume = {50},
Number = {1},
Pages = {49-50},
Month = {MAR},
Abstract = {Foreign body aspiration is a common problem in children necessitating
   prompt recognition and early treatment to minimize the potentially
   serious and sometimes even fatal consequences. Most foreign bodies can
   usually be extracted by skilful application of endoscopic techniques.
   Nevertheless, spherical foreign bodies, such as pen caps and some teeth
   remain difficult to manage. In this case report clinical presentation
   and treatment options in the treatment of a patient who had a tooth
   lodged in the right lung are discussed. The complications of foreign
   body ingestion or aspiration associated with dental treatment is
   emphasized.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Dicle Univ, Sch Med, Dept Thorac Surg, Diyarbakir, Turkey.
