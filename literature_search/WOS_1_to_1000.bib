@article{ WOS:A1980JH72300004,
Author = {HASTINGS, GE and SONNEBORN, R and LEE, GH and VICK, L and SASMOR, L},
Title = {PEER-REVIEW CHECKLIST - REPRODUCIBILITY AND VALIDITY OF A METHOD FOR
   EVALUATING THE QUALITY OF AMBULATORY CARE},
Journal = {AMERICAN JOURNAL OF PUBLIC HEALTH},
Year = {1980},
Volume = {70},
Number = {3},
Pages = {222-228},
Abstract = {The construction and evaluation of a 35-item checklist used in
   performing peer review of ambulatory medical records were described.
   Scores obtained by using the checklist were evaluated for
   reproducibility. Ten reviewers, reviewing 10 records on each of 2
   occasions, judged the records consistently item by item, 74\% of the
   time; 53\% greater than expected by chance (P < 0.01). Pairs of
   reviewers, reviewing the same 10 records, were consistent with one
   another, item by item, 72\% of the time; 35\% greater than expected by
   chance (P < 0.05). Ten sick call patients were reexamined by an
   especially trained reevaluation physician who evaluated the quality with
   which they were managed at the time of sick call. The medical records of
   the same 10 patients were reviewed with the peer review checklist. The
   correlation between the quality scores obtained by the 2 methods were
   0.72 and 0.74 on 2 trials. A correlation coefficient of 0.44 was found
   between the 2 evaluation methods when 89 cases were reviewed by a peer
   review panel composed of 10 different physicians. Peer review checklist
   scores correlated positively with scores obtained by using a series of
   disease specific protocols with explicit criteria. The correlations
   varied from 0.28-0.63 with 6 different disease specific protocols.},
