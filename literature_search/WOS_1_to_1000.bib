@article{ WOS:001305883800005,
Author = {Toossi, Shahed and Shen, Tao and Dragomer, Douglas and Nurok, Michael},
Title = {Reader Response: Pediatric and Adult Brain Death/Death by Neurologic
   Criteria Consensus Guideline: Report of the AAN Guidelines Subcommittee,
   AAP, CNS, and SCCM},
Journal = {NEUROLOGY},
Year = {2024},
Volume = {102},
Number = {9},
Month = {MAY 14},
Abstract = {The new apnea testing recommendations for death by neurologic criteria
   on venoarterial (VA) extracorporeal membrane oxygenation (ECMO) require
   PaCO2 and pH levels from both the radial and postoxygenator arterial
   blood gas (ABG) samples to have a pH <7.3, PaCO2 >60, and PaCO2 >20
   above baseline values.(1) Achieving these results may be technically
   impossible due to the variability of the membrane oxygenator function in
   ECMO. CO2 is displaced with any sweep flow. Even at the lowest sweep,
   CO2 is efficiently removed confounding the interpretation of the result.
   Without sweep gas, the ECMO circuit functions as a pure shunt and can
   lead to immediate patient demise. We recently had a patient on VA ECMO
   undergoing apnea testing with sweep at 0.5 L/min. Right radial ABG at 6
   minutes was 7.27/55/217 and postoxygenator ABG was 7.4/45/641. After 10
   minutes, the right radial ABG was 7.23/63/241 and postoxygenator ABG was
   7.37/48/625. The right radial sample most approximates the PaO2 and
   PaCO2 experienced by the brain accounting for the mixing of ventricular
   ejection and VA ECMO. Providing exogenous CO2 as recommended is usually
   not feasible. We propose that the guideline be changed to right radial
   artery sampling alone or right radial artery sampling plus ancillary
   testing.},
