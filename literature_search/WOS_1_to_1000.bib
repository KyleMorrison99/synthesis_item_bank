@article{ WOS:000254476000006,
Author = {Koizumi, Hiroyuki and Shimizu, Satoru and Oka, Hidehiro and Sagiuchi,
   Takao and Utsuki, Satoshi and Fujii, Kiyotaka},
Title = {Retro-odontoid disc herniation extracted, using the posterior-lateral
   transdural approach: Case report},
Journal = {NEUROLOGICAL SURGERY},
Year = {2008},
Volume = {36},
Number = {1},
Pages = {59-63},
Month = {JAN},
Abstract = {A 73-year-old woman suffered from neck pain, progressive motor weakness
   and sensory disturbance in all extremities. Neuroradiological studies
   revealed a retro-odontoid mass with posterior compression of the upper
   cervical spinal cord. Decompression of the mass was performed via a
   postero-lateral transclural approach, and the patient exhibited marked
   improvement of the symptoms. Histological examination revealed that the
   mass was composed of degenerative cartilaginous tissue, consistent with
   disc material, but the lesion was not neoplastic. Retro-odontoid disc
   herniation causing cervical myelopathy is very rare. We primarily
   discuss the surgical management of retro-odontoid disc herniation.},
