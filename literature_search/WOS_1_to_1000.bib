Title = {Enhancing Drug Safety Documentation Search Capabilities with Large
   Language Models: A User-Centric Approach},
Booktitle = {2023 INTERNATIONAL CONFERENCE ON COMPUTATIONAL SCIENCE AND COMPUTATIONAL
   INTELLIGENCE, CSCI 2023},
