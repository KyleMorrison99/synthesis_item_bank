@article{ WOS:000300590900008,
Author = {Vujicic, Momcilo D. and Vasovic, Stojan and Radojicic, Miroslav and
   Vasovic, Jasmina Vesic and Nesic, Zoran},
Title = {MULTI-CRITERIA APPROACH TO OPTIMIZATION OF OPTIMAL FEEDER CONDUCTOR SIZE},
Journal = {METALURGIA INTERNATIONAL},
Year = {2012},
Volume = {17},
Number = {4},
Pages = {47-52},
Abstract = {This paper presents an approach to optimization of selection of feeder
   conductor cross-section using methods of multicriteria decision making.
   The focus of the paper is related to the application of the compromise
   ranking method and a method of uncertainty for determination of the
