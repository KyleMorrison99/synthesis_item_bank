@article{ WOS:001305883800018,
Author = {Greer, David M. and Lewis, Ariane and Kirschen, Matthew P. and
   Rae-Grant, Alexander and Halperin, John J.},
Title = {Author Response: Pediatric and Adult Brain Death/Death by Neurologic
   Criteria Consensus Guideline: Report of the AAN Guidelines Subcommittee,
   AAP, CNS, and SCCM},
Journal = {NEUROLOGY},
Year = {2024},
Volume = {102},
Number = {9},
Month = {MAY 14},
Abstract = {As the lead authors of ``Pediatric and Adult Brain Death/Death by
   Neurologic Criteria Consensus Guideline,{''} we thank Dr. Machado for
   his interest in this guideline.1 The guideline defines BD/DNC as
   permanent loss of function of the brain as a whole, including the
   brainstem, leading to coma, brainstem areflexia, and apnea in the
   setting of an adequate stimulus. Evidence of neuroendocrine function
   does not preclude BD/DNC evaluation or determination (Recommendation 39,
   level B). In patients with primary posterior fossa injury, the guideline
   recommends performing a conventional neuroimaging study (CT or MRI) to
   confirm concomitant catastrophic supratentorial injury to ensure both
   supratentorial and infratentorial injuries before BD/DNC evaluation
   (Recommendation 40, level B). For all patients, including those with
   primary infratentorial injury, the assessment is clinical, and ancillary
   testing is only required if a portion of the clinical examination cannot
   be completed, there are examination findings that cannot be interpreted,
   apnea testing cannot be performed safely, the baseline level of chronic
   hypercarbia is unknown, or there are metabolic derangements that cannot
   be adequately corrected (Recommendation 27b, level A). The only accepted
   ancillary tests are 4-vessel catheter angiography, transcranial Doppler
   ultrasonography (in adults only), and radionuclide perfusion
   scintigraphy (Recommendations 29-31, level A).},
