@inproceedings{ WOS:000232022600011,
Author = {Gatos, B and Konidaris, T and Ntzios, K and Pratikakis, I and
   Perantonis, SJ},
Book-Group-Author = {IEEE Computer Society},
Title = {A segmentation-free approach for keyword search in historical
   typewritten documents},
