@inproceedings{ WOS:000281409200027,
Author = {Mizera-Pietraszko, Jolanta},
Editor = {Andreasen, T and Yager, RR and Bulskov, H and Christiansen, H and Larsen, HL},
Title = {Syntactic Extraction Approach to Processing Local Document Collections},
Booktitle = {FLEXIBLE QUERY ANSWERING SYSTEMS: 8TH INTERNATIONAL CONFERENCE, FQAS
   2009},
Series = {Lecture Notes in Artificial Intelligence},
Year = {2009},
Volume = {5822},
Pages = {312-322},
Note = {8th International Conference on Flexible Query Answering Systems,
   Roskilde Univ, Dept Commun, Business \& Informat Technol, Roskilde,
   DENMARK, OCT 26-28, 2009},
Organization = {Iona Coll, Machine Intelligence Inst},
Abstract = {Techniques of processing databases like free text searching, or
   proximity search are one of the key factors that influence efficiency of
   query answering. Since most users prefer querying systems in natural
   language, a correct answer formulation based on the electronic document
   content seems a real challenge. Processing queries in multilingual
   environment usually impedes the system responsiveness even more. This
   paper proposes an approach of over-coming these obstacles by
   implementation of syntactic information extraction. Some evaluation
   methodologies commonly used by TREC, NTCIR, SIGIR etc are studied in
   order to suggest that it is not only a system architecture itself, a
   translation model or the document format, but also other factors that
   determine the system performance. The shallow technique of the syntactic
   information extraction used appears to be a robust of the system
   described. In this light, it is possible to achieve comparable results
   when processing monolingual and cross-lingual collections.},
