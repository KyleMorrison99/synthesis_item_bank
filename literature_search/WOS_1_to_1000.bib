@article{ WOS:001305883800022,
Author = {Greer, David M. and Lewis, Ariane and Varelas, Panayiotis N. and
   Kirschen, Matthew P.},
Title = {Author Response: Pediatric and Adult Brain Death/Death by Neurologic
   Criteria Consensus Guideline: Report of the AAN Guidelines Subcommittee,
   AAP, CNS, and SCCM},
Journal = {NEUROLOGY},
Year = {2024},
Volume = {102},
Number = {9},
Month = {MAY 14},
Abstract = {We thank Dr. Toossi et al. for raising this important point. The issue
   of where to sample arterial blood for patients supported on venoarterial
   (VA) extracorporeal membrane oxygenation (ECMO) as part of the apnea
   test for patients being evaluated for brain death/death by neurologic
   criteria (BD/DNC) is physiologically complex and depends on a
   combination of cannula location and relative contributions of ECMO flow
   and native cardiac output to the cerebral circulation. The goal is to
   identify the optimal location(s) to sample arterial blood to best
   approximate the PaCO2 and pH in the cerebral circulation.},
