Year = {2006},
Volume = {18},
Number = {3},
Pages = {42-48},
Abstract = {The use of rapid participatory appraisal (RPA) methodology to assess
   community health needs in developing countries is widely supported.
   Despite this, there are few recently published practical guidelines or
   recommendations advising researchers on how best to plan, implement and
   communicate such an activity. Having recently conducted a successful RPA
