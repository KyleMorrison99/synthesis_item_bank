@inproceedings{ WOS:001283930300152,
Author = {Painter, Jeffery E. and Mahaux, Olivia and Vanini, Marco and Kara, Vijay
   and Roshan, Christie and Karwowski, Marcin and Chalamalasetti,
   Venkateswara Rao and Bate, Andrew},
