@article{ WOS:001480330900001,
Author = {Chenneville, Tiffany and Wasilewski, Serena and Stanz, Joshua and Gardy,
   Sarah and Pyle, James and Jazi, Elham Azamian},
Title = {Exploring quantity, quality, content, and impact of sexual orientation
   and gender identity publications in school psychology: A PRISMA scoping
   review},
Journal = {INTERNATIONAL JOURNAL OF SCHOOL \& EDUCATIONAL PSYCHOLOGY},
Year = {2025},
Volume = {13},
Number = {3},
Pages = {183-205},
Month = {JUL 3},
Abstract = {Youth who identify as LGBTQ + are at risk for social-emotional
   difficulties across settings due to pervasive homophobia and
   heteronormativity and resulting discrimination. Among educational
   professionals, school psychologists are particularly well positioned to
   address issues facing youth who identify as LGBTQ + through research and
   practice. Yet, there appears to be a dearth of publications on LGBTQ +
   topics in the school psychology literature. This study's objective was
   to examine the quantity, quality, content, and impact of publications
   related to gender and sexuality in the field of school psychology. Using
   the Preferred Reporting Items for Systematic Reviews and Meta-Analyses
   extension for Scoping Reviews (PRISMA-ScR), we conducted a scoping
   review of six of the most influential school psychology journals from
   the year of the first publication issue to the end of 2020 to identify
   the quantity, quality, content, and impact of empirical and conceptual
   articles published on LGBTQ + topics. The review yielded 47 articles
   across journals after removing duplicates and applying inclusion and
   exclusion criteria. Findings revealed a dearth of publications focused
   on LGBTQ + issues in school psychology journals and the need for more
   methodologically sound research on topics of gender and sexuality among
   youth to guide the evidence-based practice of school psychologists.},
