@inproceedings{ WOS:001307345000016,
Author = {Zhu, Weiran and Wang, Xinzhi and Chen, Xue and Luo, Xiangfeng},
Editor = {Huang, DS and Si, Z and Zhang, Q},
Title = {Refining ChatGPT for Document-Level Relation Extraction: A
   Multi-dimensional Prompting Approach},
Booktitle = {ADVANCED INTELLIGENT COMPUTING TECHNOLOGY AND APPLICATIONS, PT III, ICIC
   2024},
