Author = {Liu, Jiaming and Jia, Ming},
Title = {Financial distress prediction with annual reports-based deep textual
   feature extraction: A hybrid approach},
Journal = {INFORMATION SCIENCES},
Year = {2025},
Volume = {686},
Month = {JAN},
Abstract = {Predicting financial distress accurately is not only important for the
   financial health of listed companies but also vital for investors,
   regulators, and other stakeholders. Recent studies have shed light on
   the significant role of textual information in this process. This study
   introduces a novel model called BERT-TextCNN, which combines text
   embedding and deep feature extraction techniques using an ensemble
   approach. To evaluate the effectiveness of the BERT-TextCNN model, a
   comprehensive dataset of 4,784 listed companies spanning the period from
   2007 to 2022 was utilized. By leveraging this textual data, the model
   was able to effectively predict financial distress. Furthermore, the
   results demonstrated that the weighted fusion technique outperformed not
   only traditional financial indicators but also other fusion models in
   predicting financial distress accurately.},
