@article{ WOS:001305883800010,
Author = {Machado, Calixto},
Title = {Reader Response: Pediatric and Adult Brain Death/Death by Neurologic
   Criteria Consensus Guideline: Report of the AAN Guidelines Subcommittee,
   AAP, CNS, and SCCM},
Journal = {NEUROLOGY},
Year = {2024},
Volume = {102},
Number = {9},
Month = {MAY 14},
Abstract = {When a posterior fossa lesion does not provoke an increment of
   intracranial pressure, there is not a full absence of cerebral blood
   flow (CBF), explaining the preservation of EEG activity, evoked
   potentials, and autonomic function.1,2 With isolated brainstem lesions
   sparing the mesopontine tegmental reticular formation, it would
   theoretically lead to the preservation of some degree of consciousness.1
   Ancillary testing must be mandatory in posterior fossa lesions. EEG,
   Adverse Event Profiles, and sensory evoked potentials are powerful tools
   for assessing the cerebral hemispheres and brainstem. Adding
   transcranial Doppler ultrasonography as an ancillary test would conform
   to a strong battery to assess the CBF arrest and loss of bioelectrical
   activity.3 The hypothalamus plays a key role in the central control of
   the autonomic nervous system (ANS). Therefore, a residual hypothalamic
   function might reflect a remaining ANS function. All heart rate
   variability bands were preserved in Jahi McMath and showed autonomic
   reactivity to ``Mother Talks{''} stimulation, suggesting enduring
   awareness. I suggest using an ancillary test to assess the ANS, such as
   heart rate variability when a residual hypothalamic function is
   suspected.4 I agree that to begin a determination of BD/DNC is a
   clinical decision and does not require consent.5 For future research, I
   suggest studying the ANS in BD/DNC.},
